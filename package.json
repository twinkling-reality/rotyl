{
  "name": "rotyl",
  "version": "0.1.0",
  "packageManager": "pnpm@10.7.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinkling-reality/rotyl.git"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm models",
    "dev": "vite",
    "prebuild": "pnpm models",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force && tsc -p tsconfig.core.json",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tools/ci/run-tests.mjs",
    "test:raw": "vitest run",
    "test:watch": "vitest",
    "models": "node tools/model-assets/prepare.mjs",
    "models:check": "node tools/model-assets/prepare.mjs --check",
    "models:manifest": "node tools/model-assets/manifest.mjs",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "mediabunny": "1.55.1",
    "onnxruntime-web": "1.27.0",
    "preact": "10.29.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "webgpu"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@webgpu/types": "0.1.71",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webgpu": "0.4.0"
  }
}
